    ;; A absorbs B, then C absorbs A: one stream from C's writer to B's reader
    (func (export "forward-chain") (result i32)
      (local $ret i32)
      (call $new-a)
      (call $new-b)
      (call $new-c)
      (call $stream.forward (global.get $rA) (global.get $wB))
      (call $stream.forward (global.get $rC) (global.get $wA))
