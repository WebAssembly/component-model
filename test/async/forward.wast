      (if (i32.ne (i32.const 0x1 (; DROPPED=1 | (0<<4) ;)) (i32.load (i32.const 36)))
        (then unreachable))
      (i32.const 42)
    )
    (func (export "src-writer-dropped-before-forward") (result i32)
      (local $ret i32)
      (call $new-a)
      (call $new-b)
      (call $stream.drop-writable (global.get $wA))
      (call $stream.forward (global.get $rA) (global.get $wB))
      (local.set $ret (call $stream.read (global.get $rB) (i32.const 8) (i32.const 4)))
      (if (i32.ne (i32.const 0x1 (; DROPPED=1 | (0<<4) ;)) (local.get $ret))
        (then unreachable))
      (call $stream.drop-readable (global.get $rB))
