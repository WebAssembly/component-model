      (local.set $ret (call $stream.write (global.get $wA) (i32.const 0) (i32.const 4)))
      (if (i32.ne (i32.const 0x40 (; COMPLETED=0 | (4<<4) ;)) (local.get $ret))
        (then unreachable))
      (if (i32.ne (i32.const 0x04030201) (i32.load (i32.const 8)))
        (then unreachable))
      (i32.const 42)
    )

    ;; self-loop
    (func (export "self-forward") (result i32)
      (call $new-a)
      (if (i32.ne (i32.const 1) (global.get $rA))
        (then unreachable))
      (if (i32.ne (i32.const 2) (global.get $wA))
