;; When the implicit thread of a non-async-typed call blocks before returning,
;; the runtime resumes other ready threads of the same component instance until
;; the call returns. Other during-sync-* tests block with thread.suspend and
;; thread.yield; this test checks, one export per operation, that the other
;; blocking operations can also switch to a ready thread.
(component
  (component $C
    (core module $Core
      (import "" "thread.index" (func $thread.index (result i32)))
      (import "" "thread.suspend" (func $thread.suspend (result i32)))
      (import "" "thread.yield-then-resume" (func $thread.yield-then-resume (param i32) (result i32)))

      (global $blocked (mut i32) (i32.const 0))

      (func (export "block")
        (global.set $blocked (call $thread.index))
        (drop (call $thread.suspend)))

      (func (export "unblock")
        (drop (call $thread.yield-then-resume (global.get $blocked))))
    )
    (canon thread.index (core func $thread.index))
    (canon thread.suspend (core func $thread.suspend))
    (canon thread.yield-then-resume (core func $thread.yield-then-resume))
    (core instance $core (instantiate $Core (with "" (instance
      (export "thread.index" (func $thread.index))
      (export "thread.suspend" (func $thread.suspend))
      (export "thread.yield-then-resume" (func $thread.yield-then-resume))
    ))))
    (func (export "block") async
      (canon lift (core func $core "block")))
    (func (export "unblock")
      (canon lift (core func $core "unblock")))
  )
  (instance $c (instantiate $C))

  (core module $Memory (memory (export "mem") 1))
  (core instance $memory (instantiate $Memory))
  (core module $Table (table (export "tbl") 8 funcref))
  (core instance $table (instantiate $Table))
  (core module $Core
    (import "" "mem" (memory 1))
    (import "" "tbl" (table 8 funcref))
    (import "" "block" (func $block))
    (import "" "block-async" (func $block-async (result i32)))
    (import "" "unblock" (func $unblock))
    (import "" "thread.index" (func $thread.index (result i32)))
    (import "" "thread.new-indirect" (func $thread.new-indirect (param i32 i32) (result i32)))
    (import "" "thread.resume-later" (func $thread.resume-later (param i32)))
    (import "" "thread.suspend-then-promote" (func $thread.suspend-then-promote (param i32) (result i32)))
    (import "" "thread.yield-then-promote" (func $thread.yield-then-promote (param i32) (result i32)))
    (import "" "subtask.cancel" (func $subtask.cancel (param i32) (result i32)))
    (import "" "waitable-set.new" (func $waitable-set.new (result i32)))
    (import "" "waitable.join" (func $waitable.join (param i32 i32)))
    (import "" "waitable-set.wait" (func $waitable-set.wait (param i32 i32) (result i32)))
    (import "" "future.new" (func $future.new (result i64)))
    (import "" "future.read" (func $future.read (param i32 i32) (result i32)))
    (import "" "future.read-async" (func $future.read-async (param i32 i32) (result i32)))
    (import "" "future.write" (func $future.write (param i32 i32) (result i32)))
    (import "" "stream.new" (func $stream.new (result i64)))
    (import "" "stream.read" (func $stream.read (param i32 i32 i32) (result i32)))
    (import "" "stream.write" (func $stream.write (param i32 i32 i32) (result i32)))

    (func $expect (param $actual i32) (param $expected i32)
      (if (i32.ne (local.get $actual) (local.get $expected))
        (then unreachable)))
    (func $readable (param $ends i64) (result i32)
      (i32.wrap_i64 (local.get $ends)))
    (func $writable (param $ends i64) (result i32)
      (i32.wrap_i64 (i64.shr_u (local.get $ends) (i64.const 32))))

    ;; helper start functions, which record that they ran and then use their
    ;; argument (if any) to unblock the operation
    (global $helper-ran (mut i32) (i32.const 0))
    (func $call-unblock (param i32)
      (global.set $helper-ran (i32.const 1))
      (call $unblock))
    (func $write-future (param $writable i32)
      (global.set $helper-ran (i32.const 1))
      (call $expect (call $future.write (local.get $writable) (i32.const 0)) (i32.const 0 (; COMPLETED ;))))
    (func $read-future (param $readable i32)
      (global.set $helper-ran (i32.const 1))
      (call $expect (call $future.read (local.get $readable) (i32.const 0)) (i32.const 0 (; COMPLETED ;))))
    (func $write-stream (param $writable i32)
      (global.set $helper-ran (i32.const 1))
      (call $expect (call $stream.write (local.get $writable) (i32.const 0) (i32.const 1)) (i32.const 0x10 (; COMPLETED, 1 ;))))
    (func $read-stream (param $readable i32)
      (global.set $helper-ran (i32.const 1))
      (call $expect (call $stream.read (local.get $readable) (i32.const 0) (i32.const 1)) (i32.const 0x10 (; COMPLETED, 1 ;))))
    (func $resume-later (param $thread i32)
      (global.set $helper-ran (i32.const 1))
      (call $thread.resume-later (local.get $thread)))
    (func $nothing (param i32)
      (global.set $helper-ran (i32.const 1)))
    (func $unreachable (param i32)
      unreachable)
    (elem (i32.const 0) func $call-unblock $write-future $read-future $write-stream $read-stream $resume-later $nothing $unreachable)

    (func $spawn (param $helper i32) (param $arg i32)
      (global.set $helper-ran (i32.const 0))
      (call $thread.resume-later (call $thread.new-indirect (local.get $helper) (local.get $arg))))
    (func $done (result i32)
      (call $expect (global.get $helper-ran) (i32.const 1))
      (i32.const 42))

    ;; a thread that is never made ready, and so never runs
    (func $never-ready (result i32)
      (call $thread.new-indirect (i32.const 7 (; $unreachable ;)) (i32.const 0)))

    (func (export "sync-call") (result i32)
      (call $spawn (i32.const 0 (; $call-unblock ;)) (i32.const 0))
      (call $block)
      (call $done))

    (func (export "waitable-set-wait") (result i32)
      (local $ends i64) (local $ws i32)
      (local.set $ends (call $future.new))
      (call $expect (call $future.read-async (call $readable (local.get $ends)) (i32.const 0)) (i32.const -1 (; BLOCKED ;)))
      (local.set $ws (call $waitable-set.new))
      (call $waitable.join (call $readable (local.get $ends)) (local.get $ws))
      (call $spawn (i32.const 1 (; $write-future ;)) (call $writable (local.get $ends)))
      (call $expect (call $waitable-set.wait (local.get $ws) (i32.const 0)) (i32.const 4 (; FUTURE_READ ;)))
      (call $done))

    (func (export "future-read") (result i32)
      (local $ends i64)
      (local.set $ends (call $future.new))
      (call $spawn (i32.const 1 (; $write-future ;)) (call $writable (local.get $ends)))
      (call $expect (call $future.read (call $readable (local.get $ends)) (i32.const 0)) (i32.const 0 (; COMPLETED ;)))
      (call $done))

    (func (export "future-write") (result i32)
      (local $ends i64)
      (local.set $ends (call $future.new))
      (call $spawn (i32.const 2 (; $read-future ;)) (call $readable (local.get $ends)))
      (call $expect (call $future.write (call $writable (local.get $ends)) (i32.const 0)) (i32.const 0 (; COMPLETED ;)))
      (call $done))

    (func (export "stream-read") (result i32)
      (local $ends i64)
      (local.set $ends (call $stream.new))
      (call $spawn (i32.const 3 (; $write-stream ;)) (call $writable (local.get $ends)))
      (call $expect (call $stream.read (call $readable (local.get $ends)) (i32.const 0) (i32.const 1)) (i32.const 0x10 (; COMPLETED, 1 ;)))
      (call $done))

    (func (export "stream-write") (result i32)
      (local $ends i64)
      (local.set $ends (call $stream.new))
      (call $spawn (i32.const 4 (; $read-stream ;)) (call $readable (local.get $ends)))
      (call $expect (call $stream.write (call $writable (local.get $ends)) (i32.const 0) (i32.const 1)) (i32.const 0x10 (; COMPLETED, 1 ;)))
      (call $done))

    ;; "block" is suspended inside core wasm (not in a callback event loop), so
    ;; it can't receive the cancellation request, and the cancellation blocks
    ;; until "block" returns
    (func (export "subtask-cancel") (result i32)
      (local $ret i32)
      (local.set $ret (call $block-async))
      (call $expect (i32.and (local.get $ret) (i32.const 0xf)) (i32.const 1 (; STARTED ;)))
      (call $spawn (i32.const 0 (; $call-unblock ;)) (i32.const 0))
      (call $expect (call $subtask.cancel (i32.shr_u (local.get $ret) (i32.const 4))) (i32.const 2 (; RETURNED ;)))
      (call $done))

    ;; *-then-promote of a thread that isn't ready falls back to plain
    ;; thread.{suspend,yield}
    (func (export "suspend-then-promote") (result i32)
      (call $spawn (i32.const 5 (; $resume-later ;)) (call $thread.index))
      (drop (call $thread.suspend-then-promote (call $never-ready)))
      (call $done))

    ;; Since a yield may complete without switching, keep yielding until the
    ;; helper has run.
    (func (export "yield-then-promote") (result i32)
      (local $target i32)
      (local.set $target (call $never-ready))
      (call $spawn (i32.const 6 (; $nothing ;)) (i32.const 0))
      (loop $again
        (drop (call $thread.yield-then-promote (local.get $target)))
        (br_if $again (i32.eqz (global.get $helper-ran))))
      (call $done))
  )
  (type $FT (future))
  (type $ST (stream))
  (alias core export $memory "mem" (core memory $mem))
  (alias core export $table "tbl" (core table $tbl))
  (core type $start-func-ty (func (param i32)))
  (core func $thread.new-indirect (canon thread.new-indirect $start-func-ty (core table $tbl)))
  (canon lower (func $c "block") (core func $block))
  (canon lower (func $c "block") async (core func $block-async))
  (canon lower (func $c "unblock") (core func $unblock))
  (canon thread.index (core func $thread.index))
  (canon thread.resume-later (core func $thread.resume-later))
  (canon thread.suspend-then-promote (core func $thread.suspend-then-promote))
  (canon thread.yield-then-promote (core func $thread.yield-then-promote))
  (canon subtask.cancel (core func $subtask.cancel))
  (canon waitable-set.new (core func $waitable-set.new))
  (canon waitable.join (core func $waitable.join))
  (canon waitable-set.wait (memory (core memory $mem)) (core func $waitable-set.wait))
  (canon future.new $FT (core func $future.new))
  (canon future.read $FT (core func $future.read))
  (canon future.read $FT async (core func $future.read-async))
  (canon future.write $FT (core func $future.write))
  (canon stream.new $ST (core func $stream.new))
  (canon stream.read $ST (core func $stream.read))
  (canon stream.write $ST (core func $stream.write))
  (core instance $core (instantiate $Core (with "" (instance
    (export "mem" (memory $mem))
    (export "tbl" (table $tbl))
    (export "block" (func $block))
    (export "block-async" (func $block-async))
    (export "unblock" (func $unblock))
    (export "thread.index" (func $thread.index))
    (export "thread.new-indirect" (func $thread.new-indirect))
    (export "thread.resume-later" (func $thread.resume-later))
    (export "thread.suspend-then-promote" (func $thread.suspend-then-promote))
    (export "thread.yield-then-promote" (func $thread.yield-then-promote))
    (export "subtask.cancel" (func $subtask.cancel))
    (export "waitable-set.new" (func $waitable-set.new))
    (export "waitable.join" (func $waitable.join))
    (export "waitable-set.wait" (func $waitable-set.wait))
    (export "future.new" (func $future.new))
    (export "future.read" (func $future.read))
    (export "future.read-async" (func $future.read-async))
    (export "future.write" (func $future.write))
    (export "stream.new" (func $stream.new))
    (export "stream.read" (func $stream.read))
    (export "stream.write" (func $stream.write))
  ))))
  (func (export "sync-call") (result u32) (canon lift (core func $core "sync-call")))
  (func (export "waitable-set-wait") (result u32) (canon lift (core func $core "waitable-set-wait")))
  (func (export "future-read") (result u32) (canon lift (core func $core "future-read")))
  (func (export "future-write") (result u32) (canon lift (core func $core "future-write")))
  (func (export "stream-read") (result u32) (canon lift (core func $core "stream-read")))
  (func (export "stream-write") (result u32) (canon lift (core func $core "stream-write")))
  (func (export "subtask-cancel") (result u32) (canon lift (core func $core "subtask-cancel")))
  (func (export "suspend-then-promote") (result u32) (canon lift (core func $core "suspend-then-promote")))
  (func (export "yield-then-promote") (result u32) (canon lift (core func $core "yield-then-promote")))
)
(assert_return (invoke "sync-call") (u32.const 42))
(assert_return (invoke "waitable-set-wait") (u32.const 42))
(assert_return (invoke "future-read") (u32.const 42))
(assert_return (invoke "future-write") (u32.const 42))
(assert_return (invoke "stream-read") (u32.const 42))
(assert_return (invoke "stream-write") (u32.const 42))
(assert_return (invoke "subtask-cancel") (u32.const 42))
(assert_return (invoke "suspend-then-promote") (u32.const 42))
(assert_return (invoke "yield-then-promote") (u32.const 42))
