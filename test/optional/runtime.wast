;; Runtime behavior of `optional` func, instance and resource type imports.
(component definition $Tester
  (component $Impl
    (type $R (resource (rep i32)))
    (export $R' "r" (type $R))
    (canon resource.new $R (core func $resource.new))
    (core module $M
      (import "" "resource.new" (func $resource.new (param i32) (result i32)))
      (func (export "f") (result i32) (i32.const 42))
      (func (export "make") (result i32) (call $resource.new (i32.const 7))))
    (core instance $m (instantiate $M (with "" (instance (export "resource.new" (func $resource.new))))))
    (func (export "f") (result u32) (canon lift (core func $m "f")))
    (func (export "g") optional (result u32) (canon lift (core func $m "f")))
    (func (export "make") (result (own $R')) (canon lift (core func $m "make"))))

  (component $Probe
    (import "f" (func $f optional (result u32)))
    (import "i" (instance $i optional
      (export "f" (func (result u32)))
      (export "g" (func optional (result u32)))))
    (import "r" (type $r (sub optional resource)))
    (type $own (resource (rep i32)))
    (alias export $i "f" (func $i.f))
    (alias export $i "g" (func $i.g))
    (canon optional.present (func $f) (core global $f?))
    (canon optional.present (instance $i) (core global $i?))
    (canon optional.present (func $i.f) (core global $i.f?))
    (canon optional.present (func $i.g) (core global $i.g?))
    (canon optional.present (type $r) (core global $r?))
    (canon lower (func $f) (core func $f'))
    (canon lower (func $i.f) (core func $i.f'))
    (canon resource.drop $r (core func $drop))
    (canon resource.new $own (core func $new))
    (core module $M
      (import "" "f?" (global $f? i32))
      (import "" "i?" (global $i? i32))
      (import "" "i.f?" (global $i.f? i32))
      (import "" "i.g?" (global $i.g? i32))
      (import "" "r?" (global $r? i32))
      (import "" "f" (func $f (result i32)))
      (import "" "i.f" (func $i.f (result i32)))
      (import "" "drop" (func $drop (param i32)))
      (import "" "new" (func $new (param i32) (result i32)))
      (func (export "presence") (result i32)
        (i32.or (global.get $f?)
        (i32.or (i32.shl (global.get $i?) (i32.const 1))
        (i32.or (i32.shl (global.get $i.f?) (i32.const 2))
        (i32.or (i32.shl (global.get $i.g?) (i32.const 3))
                (i32.shl (global.get $r?) (i32.const 4)))))))
      (func (export "call-f") (result i32) (call $f))
      (func (export "call-i-f") (result i32) (call $i.f))
      (func (export "drop-own-as-r") (call $drop (call $new (i32.const 0))))
      (func (export "take") (param i32) (result i32)
        (call $drop (local.get 0))
        (i32.const 42)))
    (core instance $m (instantiate $M (with "" (instance
      (export "f?" (global $f?))
      (export "i?" (global $i?))
      (export "i.f?" (global $i.f?))
      (export "i.g?" (global $i.g?))
      (export "r?" (global $r?))
      (export "f" (func $f'))
      (export "i.f" (func $i.f'))
      (export "drop" (func $drop))
      (export "new" (func $new))))))
    (func (export "presence") (result u32) (canon lift (core func $m "presence")))
    (func (export "drop-own-as-r") (canon lift (core func $m "drop-own-as-r")))
    (func (export "call-f") (result u32) (canon lift (core func $m "call-f")))
    (func (export "call-i-f") (result u32) (canon lift (core func $m "call-i-f")))
    (func (export "take") optional (param "x" (own $r)) (result u32) (canon lift (core func $m "take")))
    (export "f" (func $f))
    (export "r" (type $r)))

  (instance $impl (instantiate $Impl))
  (instance $none (instantiate $Probe))
  (type $FG (instance
    (export "f" (func (result u32)))
    (export "g" (func optional (result u32)))))
  (instance $f-only (type $FG) (export "f" (func $impl "f")))
  (type $J (instance optional
    (export "f" (func (result u32)))
    (export "g" (func (result u32)))))
  (instance $j-all (type $J) (export "f" (func $impl "f")) (export "g" (func $impl "g")))
  (instance $j-some (type $J) (export "f" (func $impl "f")) (export "g" (func $none "f")))

  (instance $all (instantiate $Probe
    (with "f" (func $impl "g"))
    (with "i" (instance $impl))
    (with "r" (type $impl "r"))))
  (instance $partial (instantiate $Probe (with "f" (func $impl "f")) (with "i" (instance $f-only))))
  (instance $merged-all (instantiate $Probe (with "i" (instance $j-all))))
  (instance $merged-some (instantiate $Probe (with "i" (instance $j-some))))
  (export "none-presence" (func $none "presence"))
  (export "all-presence" (func $all "presence"))
  (export "partial-presence" (func $partial "presence"))
  (export "merged-all-presence" (func $merged-all "presence"))
  (export "merged-some-presence" (func $merged-some "presence"))
  (export "partial-call-f" (func $partial "call-f"))
  (export "merged-all-call-i-f" (func $merged-all "call-i-f"))
  (export "none-call-f" (func $none "call-f"))
  (export "merged-some-call-i-f" (func $merged-some "call-i-f"))
  (export "none-drop-own-as-r" (func $none "drop-own-as-r"))

  (canon optional.present (func $none "f") (core global $none.f?))
  (canon optional.present (func $all "f") (core global $all.f?))
  (canon optional.present (func $all "take") (core global $all.take?))
  (canon optional.present (func $partial "take") (core global $partial.take?))
  (canon lower (func $impl "make") (core func $make))
  (canon lower (func $all "take") (core func $all.take))
  (canon lower (func $none "take") (core func $none.take))
  (core module $Main
    (import "" "none.f?" (global $none.f? i32))
    (import "" "all.f?" (global $all.f? i32))
    (import "" "all.take?" (global $all.take? i32))
    (import "" "partial.take?" (global $partial.take? i32))
    (import "" "make" (func $make (result i32)))
    (import "" "all.take" (func $all.take (param i32) (result i32)))
    (import "" "none.take" (func $none.take (param i32) (result i32)))
    (func (export "run") (result i32)
      (if (i32.ne (global.get $none.f?) (i32.const 0)) (then unreachable))
      (if (i32.ne (global.get $all.f?) (i32.const 1)) (then unreachable))
      (if (i32.ne (global.get $all.take?) (i32.const 1)) (then unreachable))
      (if (i32.ne (global.get $partial.take?) (i32.const 0)) (then unreachable))
      (call $all.take (call $make)))
    ;; handle 0 is invalid, so this would trap differently if `take` were present
    (func (export "none-take") (result i32)
      (call $none.take (i32.const 0))))
  (core instance $main (instantiate $Main (with "" (instance
    (export "none.f?" (global $none.f?))
    (export "all.f?" (global $all.f?))
    (export "all.take?" (global $all.take?))
    (export "partial.take?" (global $partial.take?))
    (export "make" (func $make))
    (export "all.take" (func $all.take))
    (export "none.take" (func $none.take))))))
  (func (export "run") (result u32) (canon lift (core func $main "run")))
  (func (export "none-take") (result u32) (canon lift (core func $main "none-take"))))

(component instance $t $Tester)
(assert_return (invoke "none-presence") (u32.const 0))
(assert_return (invoke "all-presence") (u32.const 31))
(assert_return (invoke "partial-presence") (u32.const 7))
(assert_return (invoke "merged-all-presence") (u32.const 14))
(assert_return (invoke "merged-some-presence") (u32.const 0))
(assert_return (invoke "partial-call-f") (u32.const 42))
(assert_return (invoke "merged-all-call-i-f") (u32.const 42))
(assert_return (invoke "run") (u32.const 42))
(assert_trap (invoke "none-call-f") "function is not present")
(component instance $t $Tester)
(assert_trap (invoke "merged-some-call-i-f") "function is not present")
(component instance $t $Tester)
(assert_trap (invoke "none-take") "function is not present")
(component instance $t $Tester)
(assert_trap (invoke "none-drop-own-as-r") "handle index 1 used with the wrong type")

;; The type and nested instance exported by an `optional` instance are present
;; iff the instance is, and a second `optional` instance can use the first's
;; resource type.
(component definition $Tester2
  (component $Impl
    (type $R (resource (rep i32)))
    (export $R' "t" (type $R))
    (canon resource.new $R (core func $new))
    (core module $M
      (import "" "new" (func $new (param i32) (result i32)))
      (func (export "make") (result i32) (call $new (i32.const 7)))
      (func (export "take") (param i32)))
    (core instance $m (instantiate $M (with "" (instance (export "new" (func $new))))))
    (func (export "make") (result (own $R')) (canon lift (core func $m "make")))
    (func (export "take") (param "x" (own $R')) (canon lift (core func $m "take")))
    (instance $n)
    (export "n" (instance $n)))

  (component $Probe
    (import "i" (instance $i optional
      (export "t" (type $t (sub resource)))
      (export "make" (func (result (own $t))))
      (export "n" (instance))))
    (alias export $i "t" (type $t))
    (alias export $i "n" (instance $n))
    (import "j" (instance $j optional
      (alias outer $Probe $t (type $t'))
      (export "take" (func (param "x" (own $t'))))))
    (canon optional.present (instance $i) (core global $i?))
    (canon optional.present (type $t) (core global $t?))
    (canon optional.present (instance $n) (core global $n?))
    (canon optional.present (instance $j) (core global $j?))
    (canon lower (func $i "make") (core func $make))
    (canon lower (func $j "take") (core func $take))
    (core module $M
      (import "" "i?" (global $i? i32))
      (import "" "t?" (global $t? i32))
      (import "" "n?" (global $n? i32))
      (import "" "j?" (global $j? i32))
      (import "" "make" (func $make (result i32)))
      (import "" "take" (func $take (param i32)))
      (func (export "presence") (result i32)
        (if (global.get $j?) (then (call $take (call $make))))
        (i32.or (global.get $i?)
        (i32.or (i32.shl (global.get $t?) (i32.const 1))
        (i32.or (i32.shl (global.get $n?) (i32.const 2))
                (i32.shl (global.get $j?) (i32.const 3)))))))
    (core instance $m (instantiate $M (with "" (instance
      (export "i?" (global $i?))
      (export "t?" (global $t?))
      (export "n?" (global $n?))
      (export "j?" (global $j?))
      (export "make" (func $make))
      (export "take" (func $take))))))
    (func (export "presence") (result u32) (canon lift (core func $m "presence"))))

  (instance $impl (instantiate $Impl))
  (instance $both (instantiate $Probe
    (with "i" (instance $impl))
    (with "j" (instance (export "take" (func $impl "take"))))))
  (instance $only-i (instantiate $Probe (with "i" (instance $impl))))
  (instance $none (instantiate $Probe))
  (export "both" (func $both "presence"))
  (export "only-i" (func $only-i "presence"))
  (export "none" (func $none "presence")))

(component instance $t2 $Tester2)
(assert_return (invoke "both") (u32.const 15))
(assert_return (invoke "only-i") (u32.const 7))
(assert_return (invoke "none") (u32.const 0))
